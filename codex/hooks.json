{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork",
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/codex/report.mjs\"", "timeout": 3 }]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/codex/report.mjs\"", "timeout": 3 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/codex/report.mjs\"", "timeout": 3 }] }
    ],
    "Interrupt": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/codex/report.mjs\"", "timeout": 3 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/codex/report.mjs\"", "timeout": 3 }] }
    ]
  }
}
